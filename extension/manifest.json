{
  "manifest_version": 3,
  "name": "Chess Analyzer (Stockfish local)",
  "version": "1.0.0",
  "description": "Analyse tes parties chess.com avec Stockfish tournant en local sur ta machine — précision, classification des coups, courbe d'évaluation.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ouvrir l'analyseur d'échecs",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.chess.com/*",
    "http://127.0.0.1:8791/*"
  ]
}
